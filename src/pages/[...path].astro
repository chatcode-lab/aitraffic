---
import { readFile } from 'node:fs/promises';
import { marked, Renderer } from 'marked';
import Layout from '../layouts/Layout.astro';
import Diagram from '../components/Diagram.astro';
import Activity from '../components/Activity.astro';
import GuideList from '../components/GuideList.astro';
import { pages, site, guides, markdownPath, type Page } from '../lib/registry';
import sources from '../data/sources.json';
export function getStaticPaths(){ return pages.map(page=>({params:{path:page.path === '/' ? undefined : page.path.slice(1)},props:{page}})); }
interface Props {page:Page}
const {page}=Astro.props;
let body='';
try { body=await readFile(`src/content/${page.id}.md`,'utf8'); } catch(error){if(['guide','page'].includes(page.kind)) throw error;}
const toc: {text:string;id:string}[]=[];
const renderer=new Renderer();
renderer.heading=function({tokens,depth}) {const text=this.parser.parseInline(tokens); const id=text.toLowerCase().replace(/<[^>]*>/g,'').replace(/[^a-z0-9\s-]/g,'').trim().replace(/\s+/g,'-'); if(depth===2)toc.push({text:text.replace(/<[^>]*>/g,''),id});return `<h${depth} id="${id}">${text}</h${depth}>`;};
const html=await marked.parse(body,{renderer});
const minutes=Math.max(1,Math.ceil(body.split(/\s+/).length/220));
const pageSources=sources.filter(s=>page.sources.includes(s.id));
---
<Layout page={page} noindex={page.kind==='test'}>
{page.kind==='home' ? <>
 <section class="home-hero"><div><div class="eyebrow"><span class="small-rule"/>THE WEB HAS NEW READERS</div><h1>Understand your<br/><em>AI traffic.</em></h1><p class="lede">Practical guides and lightweight tools to see which agents reach your pages and collect feedback on what they find.</p><div class="actions"><a class="button" href="/live-lab">Explore the live lab <span aria-hidden="true">↗</span></a><a class="text-link" href="/guides">Read the guides <span aria-hidden="true">→</span></a></div></div><div class="hero-illustration"><Diagram compact/><p class="illustration-note"><span>FIG. 01</span> A page visit is only the beginning.</p></div></section>
 <Activity/>
 <section class="section"><div class="section-heading"><div><div class="eyebrow">START WITH THE FUNDAMENTALS</div><h2>Make sense of the signals.</h2></div><a class="text-link" href="/guides">All guides <span aria-hidden="true">↗</span></a></div><GuideList/></section>
 <section class="experiment-banner"><div><div class="eyebrow"><span class="dot" aria-hidden="true"/>AN EXPERIMENT YOU CAN INSPECT</div><h2>We’re measuring our own pages.<br/>You can follow along.</h2></div><div><p>The live lab shows actual requests reaching this site and eligible feedback from token holders. No invented activity, and no claim that a bot visit is a citation.</p><a class="text-link" href="/how-it-works">How the experiment works <span aria-hidden="true">↗</span></a></div></section>
 <section class="three-notes"><div><span class="eyebrow">01 / OBSERVE</span><h3>Requests, with context.</h3><p>Reported agents, requested pages, and delivery status. With unknowns left visible.</p></div><div><span class="eyebrow">02 / DISTINGUISH</span><h3>Visits aren’t citations.</h3><p>Human referrals, crawler requests, and answer citations tell different stories.</p></div><div><span class="eyebrow">03 / LEARN</span><h3>Feedback, when offered.</h3><p>Optional, page-specific observations. A timed challenge before submission. Unreviewed comments, never endorsements.</p></div></section>
</> : page.kind==='collection' ? <><header class="page-header"><div class="eyebrow">THE GUIDES</div><h1>{page.title}</h1><p class="lede">{page.summary}</p></header><GuideList/><div class="closing-note"><p>Three starting points. Each guide includes primary sources, practical checks, and a native Markdown version.</p><a href="/methodology">Our evidence and measurement approach →</a></div></> : page.kind==='lab' ? <>
 <header class="page-header"><div class="eyebrow"><span class="dot" aria-hidden="true"/>AI TRAFFIC & AGENT FEEDBACK LAB</div><h1>{page.title}</h1><p class="lede">{page.summary}</p></header><lab-dashboard><p class="empty-state">Data temporarily unavailable. <a href="/methodology">Read the measurement method.</a></p></lab-dashboard>
 <section class="experiment-banner"><div><div class="eyebrow">CURIOUS WHAT AN AGENT RECEIVES?</div><h2>Inspect it. Try the feedback flow.</h2></div><div><p>Test mode uses real response handling with synthetic labels. Your tests stay out of production statistics and public feedback.</p><a class="button" href="/live-lab/test">Open test mode <span aria-hidden="true">↗</span></a></div></section>
</> : page.kind==='test' ? <>
 <header class="page-header"><div class="eyebrow">LIVE LAB / SYNTHETIC TEST MODE</div><h1>{page.title}</h1><p class="lede">{page.summary}</p></header>
 <div class="test-layout"><section class="test-form"><h2>1. Choose a presentation</h2><form method="get" action="/live-lab/test"><label for="page-select">Page</label><select id="page-select" name="page">{guides.map(g=><option value={g.id}>{g.seoTitle}</option>)}</select><label for="agent-select">Simulated agent label</label><select name="agent" id="agent-select"><option>OAI-SearchBot</option><option>ChatGPT-User</option><option>ClaudeBot</option><option>PerplexityBot</option></select><button type="submit">Inspect agent response →</button></form><p class="small">Selecting a name does not authenticate that agent. All invitations and submissions from this page are tests.</p><p class="small">The form works without JavaScript. No submission is made until you choose a rating, write a comment, and submit.</p></section><section class="test-response"><h2>2. Inspect the issued response</h2><lab-test><p>Choose a page and agent, then inspect the response to receive a test invitation.</p></lab-test></section></div>
</> : <>
 <header class:list={['page-header', 'article-header']}><div class="eyebrow">{page.kind==='guide' ? <a href="/guides">FIELD GUIDE {page.number} / {page.category}</a> : 'ABOUT THE EXPERIMENT'}</div><h1>{page.title}</h1><p class="lede">{page.summary}</p><div class="article-meta"><span>By {site.publisher}</span><span>{minutes} min read</span><a href={markdownPath(page.path)}>Read as Markdown ↗</a></div><div class="small dates">Published <time datetime={page.publishedAt}>{page.publishedAt}</time> · Updated <time datetime={page.updatedAt}>{page.updatedAt}</time> · Sources checked <time datetime={page.reviewedAt}>{page.reviewedAt}</time></div></header>
 {page.kind==='guide' && <Activity/>}
 <div class="article-layout"><aside class="toc"><details open><summary>ON THIS PAGE</summary><nav aria-label="Table of contents">{toc.map(t=><a href={'#'+t.id}>{t.text}</a>)}{pageSources.length>0 && <a href="#sources">Sources & review</a>}</nav></details></aside><div><article class="prose">{page.kind==='guide' && <Diagram kind={page.illustration}/>}<div set:html={html}/></article>{pageSources.length>0 && <section class="sources" id="sources"><div class="eyebrow">FOLLOW THE EVIDENCE</div><h2>Sources & review</h2><p>Primary sources checked on {page.reviewedAt}. AI-assisted preparation; project attribution, with no independent expert review claimed.</p><ol>{pageSources.map(s=><li><a href={s.url}>{s.title} ↗</a><span>{s.publisher} · Accessed {s.accessedAt}</span><p>{s.claims}</p></li>)}</ol></section>}</div></div>
 {page.kind==='guide' && <section class="section related"><div class="section-heading"><h2>Keep exploring.</h2><a href="/guides">All guides ↗</a></div><GuideList exclude={page.id}/></section>}
</>}
</Layout>
