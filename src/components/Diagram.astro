---
interface Props { kind?: string; compact?: boolean }
const { kind = 'signals', compact = false } = Astro.props;
const captions: Record<string,string> = {
 signals: 'A request, a referral, and a piece of feedback are different observations. Keep them separate.',
 'request-path': 'An edge cache can serve the article without reaching WordPress or the origin. Collect where delivery happens.',
 'feedback-loop': 'Fetch, inspect, propose, review, and verify. Feedback informs a change; evidence decides it.',
};
---
<figure class:list={['diagram', {compact}]}>
{kind === 'signals' ? <svg viewBox="0 0 480 290" role="img" aria-label="A page connects to an agent request, a human referral, and optional feedback, shown as distinct signals.">
 <defs><pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#c9d3c9"/></pattern></defs>
 <rect width="480" height="290" fill="url(#grid)"/>
 <g fill="none" stroke="#346f64" stroke-width="1.5"><path d="M164 145H232V63H302M232 145H302M232 145V228H302"/><circle cx="232" cy="145" r="4" fill="#346f64"/>
 <rect x="57" y="92" width="107" height="107" rx="3" fill="#fcfcf6"/><path d="M77 117H139M77 131H130M77 145H140M77 159H120" stroke="#9caaa0"/>
 <rect x="302" y="40" width="130" height="46" rx="2" fill="#e9f0e6"/><rect x="302" y="122" width="130" height="46" rx="2" fill="#fcfcf6"/><rect x="302" y="204" width="130" height="46" rx="2" fill="#fcfcf6"/>
 <path d="M288 59L302 63L288 67M288 141L302 145L288 149M288 224L302 228L288 232"/>
 </g><g font-family="monospace" font-size="12" fill="#36574e"><text x="79" y="184">YOUR PAGE</text><text x="319" y="68">AGENT REQUEST</text><text x="319" y="150">HUMAN VISIT</text><text x="319" y="232">FEEDBACK</text><text x="59" y="33" font-size="10" letter-spacing="2">OBSERVE THE DIFFERENCE</text><text x="59" y="272" font-size="10" fill="#5c6c62">ONE PAGE · DISTINCT SIGNALS</text></g>
</svg> : kind === 'request-path' ? <svg viewBox="0 0 650 230" role="img" aria-label="Client requests reach the CDN first. A cache hit returns the page; a miss reaches the origin.">
 <g fill="none" stroke="#346f64" stroke-width="1.7"><path d="M150 86H245M405 86H500M325 121V175H80V121"/><path d="M235 81L245 86L235 91M490 81L500 86L490 91"/><rect x="20" y="51" width="130" height="70" fill="#fcfcf6"/><rect x="245" y="51" width="160" height="70" fill="#e9f0e6"/><rect x="500" y="51" width="130" height="70" fill="#fcfcf6"/></g>
 <g font-family="monospace" font-size="13" fill="#36574e" text-anchor="middle"><text x="85" y="91">CLIENT</text><text x="325" y="91">CDN / WORKER</text><text x="565" y="91">ORIGIN</text><text x="450" y="65" font-size="11">miss</text><text x="215" y="199" font-size="11">cache hit: origin not requested</text><text x="325" y="31" font-size="11">OBSERVATION POINT</text></g>
</svg> : <svg viewBox="0 0 650 230" role="img" aria-label="An audit loop moves from fetch to inspect to review, then verify, before returning to the page.">
 <g fill="none" stroke="#346f64" stroke-width="1.7"><path d="M145 89H235M385 89H475M550 127V185H85V127"/><path d="M225 84L235 89L225 94M465 84L475 89L465 94M80 139L85 127L90 139"/><rect x="20" y="53" width="125" height="74" fill="#fcfcf6"/><rect x="235" y="53" width="150" height="74" fill="#e9f0e6"/><rect x="475" y="53" width="150" height="74" fill="#fcfcf6"/></g>
 <g font-family="monospace" font-size="13" fill="#36574e" text-anchor="middle"><text x="83" y="94">FETCH</text><text x="310" y="94">INSPECT</text><text x="550" y="94">REVIEW</text><text x="315" y="174" font-size="11">VERIFY THE CHANGE</text><text x="315" y="32" font-size="11">EVIDENCE BEFORE EDITS</text></g>
</svg>}
{!compact && <figcaption>{captions[kind]}</figcaption>}
</figure>
