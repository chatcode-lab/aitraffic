{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aitraffic-local-tests",
  "main": "tests/fixture-worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "LAB", "class_name": "TrafficLabFixture" }] },
  "migrations": [{ "tag": "test-v1", "new_sqlite_classes": ["TrafficLabFixture"] }],
  "observability": { "enabled": false },
  "vars": { "RETENTION_DAYS": "31", "FEEDBACK_RETENTION_DAYS": "90", "TOKEN_TTL_SECONDS": "1800", "LAB_ADMIN_KEY": "synthetic-local-test-key-only" }
}
